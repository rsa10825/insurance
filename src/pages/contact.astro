---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';

const email = 'shawn@investlifetoday.com';
---

<Layout
  title="Contact Shawn Absher — Free Colonial Life Benefits Review"
  description="Reach Shawn Absher directly for a free, no-pressure Colonial Life benefits review. Email shawn@investlifetoday.com and hear back within 24 hours."
>
  <section class="bg-navy-950">
    <div class="container-x py-16 lg:py-20">
      <p class="text-xs font-medium uppercase tracking-wide text-navy-300">Contact</p>
      <h1 class="mt-4 max-w-2xl font-serif text-4xl font-semibold leading-tight text-white sm:text-5xl">
        Let's find the gaps in your coverage
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-navy-200">
        Email Shawn directly. Every review is free, and there is never any pressure
        to buy.
      </p>
    </div>
  </section>

  <section class="container-x py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.8fr]">
      <!-- Primary: email -->
      <div>
        <div class="rounded-2xl border border-navy-100 bg-navy-50 p-8 sm:p-10">
          <h2 class="font-serif text-2xl font-semibold text-navy-900">Email Shawn</h2>
          <p class="mt-3 text-navy-600">
            Send a few lines about your situation — your job, your family, the
            coverage you already have — and the best time to reach you. Shawn
            replies personally, usually within a day.
          </p>

          <a
            href={`mailto:${email}?subject=${encodeURIComponent('Benefits review request')}`}
            class="mt-6 inline-flex items-center gap-2 rounded-md bg-navy-800 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy-700"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z" /><path d="M4 7l8 6 8-6" /></svg>
            {email}
          </a>

          <p class="mt-4 text-sm text-navy-500">
            Prefer to write it yourself? Copy the address above into any email app.
          </p>
        </div>

        <div class="mt-8 rounded-2xl border border-navy-100 p-6 sm:p-8">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-navy-500">
            Helpful to mention
          </h3>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {
              products.map((p) => (
                <li class="flex gap-2 text-sm text-navy-700">
                  <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                  {p.name.replace(' Insurance', '')}
                </li>
              ))
            }
            <li class="flex gap-2 text-sm text-navy-700">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
              Small business benefits
            </li>
            <li class="flex gap-2 text-sm text-navy-700">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
              Not sure yet — that's fine
            </li>
          </ul>
        </div>
      </div>

      <!-- Direct details -->
      <aside class="space-y-6">
        <div class="rounded-2xl border border-navy-100 bg-navy-50 p-6">
          <h2 class="font-serif text-lg font-semibold text-navy-900">Reach Shawn directly</h2>
          <ul class="mt-4 space-y-4 text-sm">
            <li class="flex gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z" /><path d="M4 7l8 6 8-6" /></svg>
              <div>
                <p class="font-medium text-navy-900">Email</p>
                <a href={`mailto:${email}`} class="text-navy-600 hover:text-navy-800">{email}</a>
              </div>
            </li>
            <li class="flex gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0114 0c0 5.5-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
              <div>
                <p class="font-medium text-navy-900">Location</p>
                <p class="text-navy-600">Las Vegas, Nevada — serving clients nationwide</p>
              </div>
            </li>
            <li class="flex gap-3">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
              <div>
                <p class="font-medium text-navy-900">Response time</p>
                <p class="text-navy-600">Within 24 hours, Monday–Saturday</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-2xl border border-navy-100">
          <img
            src="/images/shawn-absher-office.avif"
            alt="Shawn Absher"
            width="1000"
            height="936"
            class="aspect-[4/3] w-full object-cover object-top"
          />
          <div class="p-5">
            <p class="font-semibold text-navy-900">Shawn Absher</p>
            <p class="text-sm text-navy-500">Independent Colonial Life Benefits Counselor</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
