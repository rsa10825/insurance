---
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { products } from '../data/products';

const steps = [
  {
    n: '01',
    title: 'Free consultation',
    body: 'We talk through your family, your job, your existing coverage, and where a gap would hurt most. No cost, no obligation.',
  },
  {
    n: '02',
    title: 'A plan built for you',
    body: 'Shawn recommends the Colonial Life products that fit — and just as often tells you what you do not need.',
  },
  {
    n: '03',
    title: 'Enroll in minutes',
    body: 'Simple applications, payroll deduction where available, and coverage that starts fast.',
  },
  {
    n: '04',
    title: 'Support at claim time',
    body: 'When something happens, Shawn helps you file and follow up so benefits get paid quickly.',
  },
];

const stats = [
  { value: '28+', label: 'Years serving Las Vegas' },
  { value: '7', label: 'Colonial Life product lines' },
  { value: '24 hrs', label: 'Typical response time' },
  { value: '$0', label: 'Cost for a benefits review' },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-950">
    <div class="pointer-events-none absolute inset-0 opacity-30 [background:radial-gradient(60%_60%_at_75%_20%,#2f5397_0%,transparent_60%)]"></div>
    <div class="container-x relative grid items-center gap-12 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wide text-navy-100">
          Independent Colonial Life Agent
        </p>
        <h1 class="mt-6 font-serif text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
          Shawn Absher is the expert for all of your insurance needs.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-200">
          Disability, life, accident, critical illness, cancer, hospital indemnity,
          and dental &amp; vision coverage from Colonial Life — explained in plain
          English and matched to your life and budget.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact"
            class="rounded-md bg-gold-400 px-6 py-3 text-center text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-500"
          >
            Get a Free Benefits Review
          </a>
          <a
            href="/coverage"
            class="rounded-md border border-white/25 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-white/10"
          >
            Explore Coverage
          </a>
        </div>
        <p class="mt-6 text-sm text-navy-300">
          Serving families &amp; small businesses in Las Vegas and nationwide.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute -inset-4 rounded-3xl bg-gold-400/10 blur-2xl"></div>
        <img
          src="/images/shawn-absher-hero.avif"
          alt="Shawn Absher, independent Colonial Life insurance agent"
          width="1000"
          height="1000"
          class="relative aspect-square w-full rounded-3xl border border-white/10 object-cover object-top shadow-2xl"
        />
        <div class="relative mx-4 -mt-8 rounded-xl border border-navy-100 bg-white p-4 shadow-lg">
          <p class="text-sm font-semibold text-navy-900">Shawn Absher</p>
          <p class="text-xs text-navy-500">Benefits Counselor · shawn@investlifetoday.com</p>
        </div>
      </div>
    </div>

    <!-- stat bar -->
    <div class="relative border-t border-white/10 bg-navy-900/60">
      <div class="container-x grid grid-cols-2 gap-6 py-8 sm:grid-cols-4">
        {
          stats.map((s) => (
            <div class="text-center sm:text-left">
              <p class="font-serif text-2xl font-semibold text-white sm:text-3xl">{s.value}</p>
              <p class="mt-1 text-xs uppercase tracking-wide text-navy-300">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Shawn -->
  <section class="container-x py-20">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="relative">
        <img
          src="/images/shawn-absher-standing.avif"
          alt="Shawn Absher"
          width="900"
          height="961"
          class="w-full rounded-2xl border border-navy-100 object-cover shadow-lg"
        />
      </div>
      <div>
        <h2 class="font-serif text-3xl font-semibold text-navy-900 sm:text-4xl">
          One person who actually knows your coverage
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-navy-600">
          Most people find out what their insurance does — and doesn't — cover on
          the worst day of their life. Shawn's job is to make sure that never
          happens to you. He walks you through every option, answers the awkward
          questions, and builds a plan you understand.
        </p>
        <ul class="mt-8 space-y-4">
          {
            [
              'Independent counsel — Shawn works for you, not a call center.',
              'Plain-English explanations of what each policy pays and when.',
              'Honest guidance, including what to skip.',
              'A real person to call when it is time to file a claim.',
            ].map((point) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 flex-none text-gold-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <span class="text-navy-700">{point}</span>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="mt-8 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-800 hover:text-navy-600">
          More about Shawn
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Coverage grid -->
  <section class="bg-navy-50 py-20">
    <div class="container-x">
      <div class="max-w-2xl">
        <h2 class="font-serif text-3xl font-semibold text-navy-900 sm:text-4xl">
          Colonial Life coverage, explained
        </h2>
        <p class="mt-4 text-lg text-navy-600">
          Seven types of voluntary protection that fill the gaps your major
          medical and employer plans leave behind.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          products.map((p) => (
            <a
              href={`/coverage#${p.slug}`}
              class="group flex flex-col rounded-2xl border border-navy-100 bg-white p-6 transition-all hover:-translate-y-1 hover:border-navy-200 hover:shadow-lg"
            >
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-navy-800 text-white">
                <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d={p.icon} />
                </svg>
              </span>
              <h3 class="mt-4 font-serif text-lg font-semibold text-navy-900">{p.name}</h3>
              <p class="mt-1 text-sm font-medium text-gold-600">{p.tagline}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-600">{p.summary}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-800 group-hover:text-navy-600">
                Learn more
                <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-x py-20">
    <div class="max-w-2xl">
      <h2 class="font-serif text-3xl font-semibold text-navy-900 sm:text-4xl">How working with Shawn goes</h2>
      <p class="mt-4 text-lg text-navy-600">Four steps, no pressure, no jargon.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s) => (
          <div class="rounded-2xl border border-navy-100 bg-white p-6">
            <p class="font-serif text-3xl font-semibold text-navy-200">{s.n}</p>
            <h3 class="mt-3 font-semibold text-navy-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-600">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-navy-50 py-20">
    <div class="container-x">
      <h2 class="font-serif text-3xl font-semibold text-navy-900 sm:text-4xl">What clients say</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          [
            {
              quote:
                'Shawn found a gap in my disability coverage I had no idea existed. When I hurt my back, the checks showed up exactly like he said they would.',
              name: 'Marcus T.',
              role: 'Contractor, Henderson',
            },
            {
              quote:
                'He sat with my whole family and explained everything without the sales pitch. We finally feel covered instead of just hoping.',
              name: 'Danielle R.',
              role: 'Small business owner, Las Vegas',
            },
            {
              quote:
                'The critical illness policy paid a lump sum within weeks of my diagnosis. Shawn handled the paperwork with me start to finish.',
              name: 'James P.',
              role: 'Retired teacher',
            },
          ].map((t) => (
            <figure class="flex flex-col rounded-2xl border border-navy-100 bg-white p-6">
              <div class="flex gap-0.5 text-gold-400">
                {Array.from({ length: 5 }).map(() => (
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z" /></svg>
                ))}
              </div>
              <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-navy-700">"{t.quote}"</blockquote>
              <figcaption class="mt-4 text-sm">
                <span class="font-semibold text-navy-900">{t.name}</span>
                <span class="text-navy-500"> · {t.role}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-6 text-xs text-navy-400">
        Client experiences shown for illustration. Individual results and benefit
        payments depend on the policy purchased and its terms.
      </p>
    </div>
  </section>

  <div class="py-20">
    <CtaBand />
  </div>
</Layout>
