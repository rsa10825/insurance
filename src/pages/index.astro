---
import '../styles/global.css';

const email = 'shawn@investlifetoday.com';
const title = 'Shawn Absher Insurance — Site Under Construction';
const description = "We're building a new site for Shawn Absher Insurance. Check back soon, or reach out by email.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-navy-950 px-6 text-center">
    <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium uppercase tracking-wide text-navy-100">
      Shawn Absher Insurance
    </p>
    <h1 class="mt-6 font-serif text-4xl font-semibold leading-tight text-white sm:text-5xl">
      We're under construction.
    </h1>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-navy-200">
      Our new site is on the way. In the meantime, reach out by email and we'll get right back to you.
    </p>
    <a
      href={`mailto:${email}?subject=${encodeURIComponent('Benefits review for our company')}`}
      class="mt-8 rounded-md bg-gold-400 px-6 py-3 text-center text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-500"
    >
      {email}
    </a>
    <a
      href="https://www.facebook.com/AbsherHomeInspections"
      target="_blank"
      rel="noopener"
      class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-navy-200 underline-offset-4 hover:text-white hover:underline"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
      </svg>
      Find us on Facebook
    </a>
  </body>
</html>
